+		})
+	}
+
+	setExactCPUCreateGlobals(t)
+	createEnv = `{"MICKEY_CONTROL_PLANE_NONCE":"` + strings.Repeat("aB", 32) + `"}`
+	if err := validateCPUCreateConfig("COMMUNITY"); err != nil {
+		t.Fatalf("valid allowlisted nonce rejected: %v", err)
