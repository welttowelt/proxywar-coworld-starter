+func parseCPUCreateEnv(encoded string) (map[string]string, error) {
+	if strings.TrimSpace(encoded) == "" {
+		return nil, nil
+	}
+	var env map[string]string
+	if err := json.Unmarshal([]byte(encoded), &env); err != nil {
+		return nil, fmt.Errorf("CPU --env must be a JSON object containing only a 64-hex %s value", cpuControlPlaneNonceEnvKey)
+	}
+	nonce, ok := env[cpuControlPlaneNonceEnvKey]
+	if !ok || len(env) != 1 || len(nonce) != 64 {
+		return nil, fmt.Errorf("CPU --env must contain only a 64-hex %s value", cpuControlPlaneNonceEnvKey)
+	}
+	decoded, err := hex.DecodeString(nonce)
+	if err != nil || len(decoded) != 32 {
+		return nil, fmt.Errorf("CPU --env must contain only a 64-hex %s value", cpuControlPlaneNonceEnvKey)
+	}
+	return env, nil
+}
+
+func redactCPUCreateError(err error, env map[string]string) error {
+	if err == nil {
+		return nil
+	}
+	message := err.Error()
+	for _, value := range env {
+		if value != "" {
+			message = strings.ReplaceAll(message, value, cpuEnvRedactedValueMarker)
+		}
+	}
+	return fmt.Errorf("%s", message)
+}
+
 func isFinitePositive(value float64) bool {
 	return value > 0 && !math.IsNaN(value) && !math.IsInf(value, 0)
 }
