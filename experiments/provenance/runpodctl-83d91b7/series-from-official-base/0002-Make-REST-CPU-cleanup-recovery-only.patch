+	}
+	encoded, err := json.Marshal(receipt)
+	if err != nil {
+		t.Fatalf("marshal receipt: %v", err)
+	}
+	if strings.Contains(string(encoded), nonce) {
+		t.Fatalf("receipt leaked nonce: %s", encoded)
+	}
+}
