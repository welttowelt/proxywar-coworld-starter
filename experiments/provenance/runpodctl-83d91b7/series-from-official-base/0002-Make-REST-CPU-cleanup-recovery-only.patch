+func TestCPUCreateRESTScrubsNonceFromProviderError(t *testing.T) {
+	viper.Reset()
+	t.Cleanup(viper.Reset)
+	setExactCPUCreateGlobals(t)
+	nonce := strings.Repeat("cd", 32)
+	createEnv = `{"MICKEY_CONTROL_PLANE_NONCE":"` + nonce + `"}`
+
+	var deleteCalls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodDelete {
+			deleteCalls.Add(1)
+		}
+		w.WriteHeader(http.StatusBadRequest)
+		_, _ = w.Write([]byte(`{"error":"provider echoed ` + nonce + `"}`))
+	}))
+	t.Cleanup(server.Close)
+	t.Setenv("RUNPOD_API_KEY", "test-key")
+	t.Setenv("RUNPOD_API_URL", server.URL)
+
+	result, err := createPodREST("CPU", "", "COMMUNITY", false)
+	if err == nil {
+		t.Fatal("expected provider error")
+	}
+	if result != nil {
+		t.Fatalf("result = %#v, want nil", result)
+	}
+	if strings.Contains(err.Error(), nonce) {
+		t.Fatalf("provider error leaked nonce: %v", err)
+	}
+	if got := deleteCalls.Load(); got != 0 {
+		t.Fatalf("DELETE calls = %d, want 0", got)
+	}
+}
