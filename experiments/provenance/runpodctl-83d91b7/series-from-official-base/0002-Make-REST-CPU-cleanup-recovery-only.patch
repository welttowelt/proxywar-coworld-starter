 	receipt["requestInputSha256"] = hex.EncodeToString(digest[:])
 	receipt["requestInputHashAlgorithm"] = restRequestInputHashAlgorithm
+	receipt["requestInputHashScope"] = restRequestInputHashScope
+	receipt["requestInputRedacted"] = requestInputRedacted
+	receipt["requestInputRedactionSchema"] = cpuEnvRedactionSchema
+	receipt["responseEnvRedacted"] = responseEnvRedacted
+	receipt["responseEnvRedactionSchema"] = cpuEnvRedactionSchema
+	receipt["redactedEnvValueMarker"] = cpuEnvRedactedValueMarker
 	receipt["transport"] = "rest-v1"
 	receipt["clientMaxCostPerHour"] = maxCostPerHour
 	receipt["validationPassed"] = validationErr == nil
 	if validationErr != nil {
 		receipt["validationError"] = validationErr.Error()
 	}
-	receipt["cleanupAttempted"] = cleanupAttempted
-	receipt["cleanupSucceeded"] = cleanupSucceeded
-	if cleanupError != "" {
-		receipt["cleanupError"] = cleanupError
-	}
+	receipt["cleanupAttempted"] = false
+	receipt["cleanupSucceeded"] = false
 	return receipt, nil
 }
 
+func redactJSONEnvValues(object map[string]interface{}) bool {
+	rawEnv, ok := object["env"]
+	if !ok {
+		return false
+	}
+	env, ok := rawEnv.(map[string]interface{})
+	if !ok || len(env) == 0 {
+		return false
+	}
+	for key := range env {
+		env[key] = cpuEnvRedactedValueMarker
+	}
+	return true
+}
