+func TestCPUCreateRESTDeletesExactNamePodAboveClientCostCeiling(t *testing.T) {
+	viper.Reset()
+	t.Cleanup(viper.Reset)
+	setExactCPUCreateGlobals(t)
+
+	deleted := make(chan string, 1)
