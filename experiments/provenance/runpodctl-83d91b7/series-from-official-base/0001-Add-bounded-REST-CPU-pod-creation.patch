+// UnmarshalJSON accepts costPerHr as either a JSON number or a numeric JSON
+// string, so an encoding difference cannot hide an already-created pod from
+// cleanup.
+func (p *Pod) UnmarshalJSON(data []byte) error {
+	type podAlias Pod
+	wire := struct {
+		*podAlias
+		CostPerHr json.RawMessage `json:"costPerHr"`
+	}{podAlias: (*podAlias)(p)}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return err
+	}
+
+	raw := bytes.TrimSpace(wire.CostPerHr)
+	if len(raw) == 0 || bytes.Equal(raw, []byte("null")) {
+		return nil
+	}
+	if raw[0] == '"' {
+		var encoded string
+		if err := json.Unmarshal(raw, &encoded); err != nil {
+			return fmt.Errorf("decode costPerHr string: %w", err)
+		}
+		value, err := strconv.ParseFloat(encoded, 64)
+		if err != nil {
+			return fmt.Errorf("decode costPerHr numeric string %q: %w", encoded, err)
+		}
+		p.CostPerHr = value
+		return nil
+	}
+	if err := json.Unmarshal(raw, &p.CostPerHr); err != nil {
+		return fmt.Errorf("decode costPerHr number: %w", err)
+	}
+	return nil
+}
