+
+func TestCPUCreateRESTUsesExactRequestAndReturnsAttestedReceipt(t *testing.T) {
+	viper.Reset()
+	t.Cleanup(viper.Reset)
+	setExactCPUCreateGlobals(t)
+
+	requestBody := make(chan map[string]interface{}, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost || r.URL.Path != "/pods" {
+			t.Errorf("request = %s %s, want POST /pods", r.Method, r.URL.Path)
+		}
+		var body map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Errorf("decode request: %v", err)
+			return
+		}
+		requestBody <- body
+		_ = json.NewEncoder(w).Encode(api.Pod{
+			ID:                "cpu-pod-123",
+			Name:              createName,
+			ComputeType:       "CPU",
+			CloudType:         "COMMUNITY",
+			DesiredStatus:     "RUNNING",
+			ImageName:         createImageName,
+			GpuCount:          0,
+			VolumeInGb:        0,
+			ContainerDiskInGb: 20,
+			MemoryInGb:        4,
+			VcpuCount:         2,
+			CPUFlavorID:       "cpu5c",
+			CostPerHr:         0.06,
+		})
+	}))
+	t.Cleanup(server.Close)
+	t.Setenv("RUNPOD_API_KEY", "test-key")
+	t.Setenv("RUNPOD_API_URL", server.URL)
+
+	if err := validateCPUCreateConfig("COMMUNITY"); err != nil {
+		t.Fatalf("validate config: %v", err)
+	}
+	result, err := createPodREST("CPU", "", "COMMUNITY", false)
+	if err != nil {
+		t.Fatalf("create pod: %v", err)
+	}
+	receipt, ok := result.(map[string]interface{})
+	if !ok {
+		t.Fatalf("receipt type = %T", result)
+	}
+	body := <-requestBody
+
+	wantFlavors := []interface{}{"cpu5c", "cpu3c"}
+	if got := body["computeType"]; got != "CPU" {
+		t.Fatalf("computeType = %#v, want CPU", got)
+	}
+	if got := body["cpuFlavorIds"]; !reflect.DeepEqual(got, wantFlavors) {
+		t.Fatalf("cpuFlavorIds = %#v, want %#v", got, wantFlavors)
+	}
+	assertRESTJSONNumber(t, body, "vcpuCount", 2)
+	assertRESTJSONNumber(t, body, "containerDiskInGb", 20)
+	assertRESTJSONNumber(t, body, "volumeInGb", 0)
+	if got := body["cloudType"]; got != "COMMUNITY" {
+		t.Fatalf("cloudType = %#v, want COMMUNITY", got)
+	}
+	for _, forbidden := range []string{
+		"gpuTypeIds", "gpuCount", "networkVolumeId", "terminateAfter", "stopAfter", "maxCostPerHour", "deployCost",
+	} {
+		if _, present := body[forbidden]; present {
+			t.Fatalf("REST request unexpectedly contains %s: %#v", forbidden, body)
+		}
+	}
+
+	if receipt["id"] != "cpu-pod-123" || receipt["name"] != createName || receipt["costPerHr"] != 0.06 {
+		t.Fatalf("receipt does not preserve id/name/cost: %#v", receipt)
+	}
+	if receipt["transport"] != "rest-v1" || receipt["validationPassed"] != true {
+		t.Fatalf("receipt transport/validation = %#v", receipt)
+	}
+	requestInput, ok := receipt["requestInput"].(map[string]interface{})
+	if !ok || !reflect.DeepEqual(requestInput, body) {
+		t.Fatalf("requestInput = %#v, want exact POST body %#v", receipt["requestInput"], body)
+	}
+	canonical, err := canonicalRESTRequestJSON(requestInput)
+	if err != nil {
+		t.Fatalf("canonical request: %v", err)
+	}
+	digest := sha256.Sum256(canonical)
+	if got := receipt["requestInputSha256"]; got != hex.EncodeToString(digest[:]) {
+		t.Fatalf("requestInputSha256 = %#v", got)
+	}
+	encoded, err := json.Marshal(receipt)
+	if err != nil {
+		t.Fatalf("receipt must remain parseable JSON: %v", err)
+	}
+	var decoded map[string]interface{}
+	if err := json.Unmarshal(encoded, &decoded); err != nil {
+		t.Fatalf("decode receipt JSON: %v", err)
+	}
+}
+
+func assertRESTJSONNumber(t *testing.T, object map[string]interface{}, key string, want float64) {
+	t.Helper()
+	got, ok := object[key].(float64)
+	if !ok || got != want {
+		t.Fatalf("%s = %#v, want %v", key, object[key], want)
+	}
+}
