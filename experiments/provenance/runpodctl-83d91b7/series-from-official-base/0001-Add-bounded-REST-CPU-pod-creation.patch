+var requiredCPUFlavorIDs = []string{"cpu5c", "cpu3c"}
+
+const restRequestInputHashAlgorithm = "sorted-json-sha256-v1"
+
+func validateCPUCreateConfig(cloudType string) error {
+	flavors := make([]string, len(createCPUFlavorIDs))
+	for index, value := range createCPUFlavorIDs {
+		flavors[index] = strings.TrimSpace(value)
+	}
+	if !reflect.DeepEqual(flavors, requiredCPUFlavorIDs) {
+		return fmt.Errorf("CPU create requires --cpu-flavor-id cpu5c --cpu-flavor-id cpu3c in that fallback order")
+	}
+	if createVCPUCount != 2 {
+		return fmt.Errorf("CPU create requires --vcpu-count 2")
+	}
+	if !isFinitePositive(createMaxCostPerHour) || createMaxCostPerHour > 0.10 {
+		return fmt.Errorf("CPU create requires a finite --max-cost-per-hour greater than 0 and at most 0.10")
+	}
+	if createContainerDiskInGb != 20 {
+		return fmt.Errorf("CPU create requires --container-disk-in-gb 20")
+	}
+	if createVolumeInGb != 0 {
+		return fmt.Errorf("CPU create requires --volume-in-gb 0")
+	}
+	if strings.TrimSpace(createNetworkVolumeID) != "" {
+		return fmt.Errorf("CPU create does not permit --network-volume-id")
+	}
+	if cloudType != "COMMUNITY" {
+		return fmt.Errorf("CPU create requires --cloud-type COMMUNITY")
+	}
+	if strings.TrimSpace(createName) == "" {
+		return fmt.Errorf("CPU create requires --name for exact-ID reconciliation")
+	}
+	if strings.HasPrefix(createName, "storm-") {
+		return fmt.Errorf("CPU create refuses the protected storm- pod namespace")
+	}
+	if strings.TrimSpace(createImageName) == "" || strings.TrimSpace(createTemplateID) != "" {
+		return fmt.Errorf("CPU create requires --image and does not permit --template-id")
+	}
+	if strings.TrimSpace(createStopAfter) != "" || strings.TrimSpace(createTerminateAfter) != "" {
+		return fmt.Errorf("CPU REST create does not support --stop-after or --terminate-after; use an independent exact-ID cleanup watchdog")
+	}
+	return nil
+}
+
+func isFinitePositive(value float64) bool {
+	return value > 0 && !math.IsNaN(value) && !math.IsInf(value, 0)
+}
+
+func validateCPUCreateResponse(pod *api.Pod, req *api.PodCreateRequest, maxCostPerHour float64) error {
+	if pod == nil {
+		return fmt.Errorf("provider returned an empty pod")
+	}
+	if strings.TrimSpace(pod.ID) == "" {
+		return fmt.Errorf("provider response omitted pod id")
+	}
+	if pod.Name != req.Name {
+		return fmt.Errorf("provider returned pod name %q, want %q", pod.Name, req.Name)
+	}
+	if !isFinitePositive(pod.CostPerHr) {
+		return fmt.Errorf("provider response omitted a finite positive costPerHr")
+	}
+	if pod.CostPerHr > maxCostPerHour {
+		return fmt.Errorf("provider costPerHr %.6f exceeds client ceiling %.6f", pod.CostPerHr, maxCostPerHour)
+	}
+	if pod.ContainerDiskInGb != req.ContainerDiskInGb {
+		return fmt.Errorf("provider containerDiskInGb %d, want %d", pod.ContainerDiskInGb, req.ContainerDiskInGb)
+	}
+	if pod.VolumeInGb != req.VolumeInGb {
+		return fmt.Errorf("provider volumeInGb %d, want %d", pod.VolumeInGb, req.VolumeInGb)
+	}
+	if pod.GpuCount != 0 {
+		return fmt.Errorf("provider gpuCount %d, want 0", pod.GpuCount)
+	}
+	if pod.VcpuCount != 0 && pod.VcpuCount != req.VcpuCount {
+		return fmt.Errorf("provider vcpuCount %d, want %d", pod.VcpuCount, req.VcpuCount)
+	}
+	if pod.MemoryInGb != 0 && pod.MemoryInGb != 4 {
+		return fmt.Errorf("provider memoryInGb %d, want 4", pod.MemoryInGb)
+	}
+	if pod.ComputeType != "" && !strings.EqualFold(pod.ComputeType, req.ComputeType) {
+		return fmt.Errorf("provider computeType %q, want %q", pod.ComputeType, req.ComputeType)
+	}
+	if pod.CloudType != "" && !strings.EqualFold(pod.CloudType, req.CloudType) {
+		return fmt.Errorf("provider cloudType %q, want %q", pod.CloudType, req.CloudType)
+	}
+	if pod.CPUFlavorID != "" && pod.CPUFlavorID != requiredCPUFlavorIDs[0] && pod.CPUFlavorID != requiredCPUFlavorIDs[1] {
+		return fmt.Errorf("provider cpuFlavorId %q is outside the requested fallback set", pod.CPUFlavorID)
+	}
+	if pod.ImageName != "" && pod.ImageName != req.ImageName {
+		return fmt.Errorf("provider imageName %q, want %q", pod.ImageName, req.ImageName)
+	}
+	if pod.NetworkVolumeID != "" {
+		return fmt.Errorf("provider attached unexpected networkVolumeId %q", pod.NetworkVolumeID)
+	}
+	return nil
+}
+
+func createCPUCreateReceipt(
+	pod *api.Pod,
+	req *api.PodCreateRequest,
+	maxCostPerHour float64,
+	validationErr error,
+	cleanupAttempted bool,
+	cleanupSucceeded bool,
+	cleanupError string,
+) (map[string]interface{}, error) {
+	podJSON, err := json.Marshal(pod)
+	if err != nil {
+		return nil, fmt.Errorf("encode cpu create response: %w", err)
+	}
+	receipt := map[string]interface{}{}
+	if err := json.Unmarshal(podJSON, &receipt); err != nil {
+		return nil, fmt.Errorf("decode cpu create response: %w", err)
+	}
+
+	requestJSON, err := canonicalRESTRequestJSON(req)
+	if err != nil {
+		return nil, fmt.Errorf("canonicalize cpu REST request: %w", err)
+	}
+	var requestInput interface{}
+	if err := json.Unmarshal(requestJSON, &requestInput); err != nil {
+		return nil, fmt.Errorf("decode cpu REST request: %w", err)
+	}
+	digest := sha256.Sum256(requestJSON)
+	receipt["requestInput"] = requestInput
+	receipt["requestInputSha256"] = hex.EncodeToString(digest[:])
+	receipt["requestInputHashAlgorithm"] = restRequestInputHashAlgorithm
+	receipt["transport"] = "rest-v1"
+	receipt["clientMaxCostPerHour"] = maxCostPerHour
+	receipt["validationPassed"] = validationErr == nil
+	if validationErr != nil {
+		receipt["validationError"] = validationErr.Error()
+	}
+	receipt["cleanupAttempted"] = cleanupAttempted
+	receipt["cleanupSucceeded"] = cleanupSucceeded
+	if cleanupError != "" {
+		receipt["cleanupError"] = cleanupError
+	}
+	return receipt, nil
+}
+
+func canonicalRESTRequestJSON(value interface{}) ([]byte, error) {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return nil, err
+	}
+	var decoded interface{}
+	if err := json.Unmarshal(encoded, &decoded); err != nil {
+		return nil, err
+	}
+	return json.Marshal(decoded)
 }
 
