+func assertNoNonceFold(t *testing.T, label string, value []byte, nonce string) {
+	t.Helper()
+	if strings.Contains(strings.ToLower(string(value)), strings.ToLower(nonce)) {
+		t.Fatalf("%s leaked nonce: %q", label, value)
+	}
+}
