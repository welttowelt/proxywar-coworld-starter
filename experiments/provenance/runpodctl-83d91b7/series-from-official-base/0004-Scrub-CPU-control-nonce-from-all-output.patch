+func captureRunCreateOutput(t *testing.T, command *cobra.Command) ([]byte, []byte, error) {
+	t.Helper()
+	stdoutRead, stdoutWrite, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("stdout pipe: %v", err)
+	}
+	stderrRead, stderrWrite, err := os.Pipe()
+	if err != nil {
+		_ = stdoutRead.Close()
+		_ = stdoutWrite.Close()
+		t.Fatalf("stderr pipe: %v", err)
+	}
+	oldStdout := os.Stdout
+	oldStderr := os.Stderr
+	os.Stdout = stdoutWrite
+	os.Stderr = stderrWrite
+	t.Cleanup(func() {
+		os.Stdout = oldStdout
+		os.Stderr = oldStderr
+		_ = stdoutRead.Close()
+		_ = stdoutWrite.Close()
+		_ = stderrRead.Close()
+		_ = stderrWrite.Close()
+	})
+
+	runErr := runCreate(command, nil)
+	_ = stdoutWrite.Close()
+	_ = stderrWrite.Close()
+	os.Stdout = oldStdout
+	os.Stderr = oldStderr
+	stdout, err := io.ReadAll(stdoutRead)
+	if err != nil {
+		t.Fatalf("read stdout: %v", err)
+	}
+	stderr, err := io.ReadAll(stderrRead)
+	if err != nil {
+		t.Fatalf("read stderr: %v", err)
+	}
+	return stdout, stderr, runErr
+}
