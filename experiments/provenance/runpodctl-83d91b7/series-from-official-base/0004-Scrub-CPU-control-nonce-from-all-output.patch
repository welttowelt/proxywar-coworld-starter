+func guardCPUCreateOutward(result interface{}, err error, controlSecret string) (interface{}, error) {
+	if controlSecret == "" {
+		return result, err
+	}
+	if err != nil && containsCPUControlSecret(err.Error(), controlSecret) {
+		return nil, fmt.Errorf("%s", cpuOutwardGuardError)
+	}
+	if result == nil {
+		return nil, err
+	}
+	encoded, marshalErr := json.Marshal(result)
+	if marshalErr != nil || containsCPUControlSecret(string(encoded), controlSecret) {
+		return nil, fmt.Errorf("%s", cpuOutwardGuardError)
+	}
+	return result, err
+}
+
+func containsCPUControlSecret(value, controlSecret string) bool {
+	if controlSecret == "" || len(value) < len(controlSecret) {
+		return false
+	}
+	for index := 0; index+len(controlSecret) <= len(value); index++ {
+		if strings.EqualFold(value[index:index+len(controlSecret)], controlSecret) {
+			return true
+		}
+	}
+	return false
+}
+
+func scrubCPUControlSecretString(value, controlSecret string) (string, bool) {
+	if !containsCPUControlSecret(value, controlSecret) {
+		return value, false
+	}
+	var scrubbed strings.Builder
+	scrubbed.Grow(len(value))
+	changed := false
+	for index := 0; index < len(value); {
+		if index+len(controlSecret) <= len(value) && strings.EqualFold(value[index:index+len(controlSecret)], controlSecret) {
+			scrubbed.WriteString(cpuEnvRedactedValueMarker)
+			index += len(controlSecret)
+			changed = true
+			continue
+		}
+		scrubbed.WriteByte(value[index])
+		index++
+	}
+	return scrubbed.String(), changed
+}
