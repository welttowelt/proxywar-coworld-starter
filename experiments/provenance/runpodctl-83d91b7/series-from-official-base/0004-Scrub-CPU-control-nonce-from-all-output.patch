+func TestCPUCreateEnvStdinScrubsHostileSuccessResponseEverywhere(t *testing.T) {
+	viper.Reset()
+	t.Cleanup(viper.Reset)
+	setExactCPUCreateGlobals(t)
+	createEnvStdin = true
+	createPublicIP = true
+	createPorts = "22/tcp"
+	nonce := strings.Repeat("aB", 32)
+	echo := strings.ToUpper(nonce)
+	encodedEnv := `{"MICKEY_CONTROL_PLANE_NONCE":"` + nonce + `"}`
+
+	var deleteCalls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodDelete {
+			deleteCalls.Add(1)
+			w.WriteHeader(http.StatusNoContent)
+			return
+		}
+		if r.Method != http.MethodPost || r.URL.Path != "/pods" {
+			t.Errorf("request = %s %s, want POST /pods", r.Method, r.URL.Path)
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		_ = json.NewEncoder(w).Encode(map[string]interface{}{
+			"id":                "provider-id-" + echo,
+			"name":              createName + "-" + echo,
+			"computeType":       "CPU",
+			"cloudType":         "COMMUNITY",
+			"desiredStatus":     "running-" + echo,
+			"imageName":         createImageName + "-" + echo,
+			"gpuCount":          0,
+			"volumeInGb":        0,
+			"containerDiskInGb": 20,
+			"memoryInGb":        4,
+			"vcpuCount":         2,
+			"costPerHr":         0.06,
+			"networkVolumeId":   "network-" + echo,
+			"ports":             []string{"22/tcp", "port-" + echo},
+			"createdAt":         map[string]interface{}{echo: "created-" + echo},
+			"machine": map[string]interface{}{
+				echo: "machine-value-" + echo,
+				"nested": []interface{}{
+					map[string]interface{}{"unknown": "nested-" + echo},
+				},
+				"env": map[string]interface{}{echo: "env-" + echo},
+			},
+			"runtime": map[string]interface{}{"unknown-" + echo: "runtime-" + echo},
+			"env":     map[string]string{echo: "value-" + echo},
+			"unknownTopLevel": map[string]interface{}{
+				"unknown-" + echo: "top-level-" + echo,
+			},
+		})
+	}))
+	t.Cleanup(server.Close)
+	t.Setenv("RUNPOD_API_KEY", "test-key")
+	t.Setenv("RUNPOD_API_URL", server.URL)
+
+	command := &cobra.Command{}
+	command.Flags().String("output", "json", "")
+	command.SetIn(strings.NewReader(encodedEnv))
+	stdout, stderr, runErr := captureRunCreateOutput(t, command)
+	if runErr == nil || !strings.Contains(runErr.Error(), "provider identity contained") {
+		t.Fatalf("error = %v, want contaminated identity failure", runErr)
+	}
+	assertNoNonceFold(t, "stdout", stdout, nonce)
+	assertNoNonceFold(t, "stderr", stderr, nonce)
+	assertNoNonceFold(t, "returned error", []byte(runErr.Error()), nonce)
+	if got := deleteCalls.Load(); got != 0 {
+		t.Fatalf("DELETE calls = %d, want 0", got)
+	}
+
+	var receipt map[string]interface{}
+	if err := json.Unmarshal(stdout, &receipt); err != nil {
+		t.Fatalf("stdout is not a parseable redacted receipt: %v: %q", err, stdout)
+	}
+	if receipt["id"] != cpuEnvRedactedValueMarker || receipt["name"] != cpuEnvRedactedValueMarker {
+		t.Fatalf("contaminated provider identity was not suppressed: %#v", receipt)
+	}
+	if receipt["providerIdentityContaminated"] != true || receipt["reconciliationRequired"] != true || receipt["validationPassed"] != false {
+		t.Fatalf("identity reconciliation flags missing: %#v", receipt)
+	}
+	if receipt["responseControlSecretScrubbed"] != true {
+		t.Fatalf("response scrub marker missing: %#v", receipt)
+	}
+	envMetadata, ok := receipt["env"].(map[string]interface{})
+	if !ok || envMetadata["redacted"] != true || envMetadata["schema"] != cpuEnvRedactionSchema {
+		t.Fatalf("provider env was not replaced with metadata: %#v", receipt["env"])
+	}
+	if receipt["cleanupAttempted"] != false || receipt["cleanupSucceeded"] != false {
+		t.Fatalf("hostile response path must remain zero-delete: %#v", receipt)
+	}
+	encodedReceipt, err := json.Marshal(receipt)
+	if err != nil {
+		t.Fatalf("marshal receipt: %v", err)
+	}
+	assertNoNonceFold(t, "decoded receipt", encodedReceipt, nonce)
+}
