+func TestCPUCreateEnvStdinRequiresCanonicalSSHExposure(t *testing.T) {
+	tests := []struct {
+		name     string
+		publicIP bool
+		ports    string
+		want     string
+	}{
+		{name: "missing public ip", publicIP: false, ports: "22/tcp", want: "--public-ip"},
+		{name: "missing port", publicIP: true, ports: "", want: "exactly --ports 22/tcp"},
+		{name: "additional port", publicIP: true, ports: "22/tcp,8888/http", want: "exactly --ports 22/tcp"},
+		{name: "noncanonical whitespace", publicIP: true, ports: " 22/tcp", want: "exactly --ports 22/tcp"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			setExactCPUCreateGlobals(t)
+			createEnvStdin = true
+			createPublicIP = tt.publicIP
+			createPorts = tt.ports
+			err := validateCPUCreateConfig("COMMUNITY")
