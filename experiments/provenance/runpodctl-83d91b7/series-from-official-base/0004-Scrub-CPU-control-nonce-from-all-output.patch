+func TestCPUControlSecretScrubberIsExactCaseInsensitiveAndNonDestructive(t *testing.T) {
+	nonce := strings.Repeat("aB", 32)
+	otherHex := strings.Repeat("cd", 32)
+	input := "prefix-" + strings.ToUpper(nonce) + "-middle-" + otherHex + "-suffix-" + nonce
+	scrubbed, changed := scrubCPUControlSecretString(input, nonce)
+	if !changed {
+		t.Fatal("mixed-case exact secret was not detected")
+	}
+	assertNoNonceFold(t, "scrubbed string", []byte(scrubbed), nonce)
+	if !strings.Contains(scrubbed, otherHex) {
+		t.Fatalf("unrelated 64-hex value was corrupted: %q", scrubbed)
+	}
+	if strings.Count(scrubbed, cpuEnvRedactedValueMarker) != 2 {
+		t.Fatalf("scrubbed occurrences = %q, want two markers", scrubbed)
+	}
+
+	unchanged, changed := scrubCPUControlSecretString("legitimate-"+otherHex, nonce)
+	if changed || unchanged != "legitimate-"+otherHex {
+		t.Fatalf("non-secret value was modified: changed=%v value=%q", changed, unchanged)
+	}
+}
