+func scrubCPUCreatePod(pod *api.Pod, controlSecret string) (*api.Pod, bool) {
+	if pod == nil {
+		return nil, false
+	}
+	clean := *pod
+	changed := false
+	scrubString := func(value string) string {
+		scrubbed, fieldChanged := scrubCPUControlSecretString(value, controlSecret)
+		changed = changed || fieldChanged
+		return scrubbed
+	}
+
+	clean.ID = scrubString(pod.ID)
+	clean.Name = scrubString(pod.Name)
+	clean.ComputeType = scrubString(pod.ComputeType)
+	clean.CloudType = scrubString(pod.CloudType)
+	clean.DesiredStatus = scrubString(pod.DesiredStatus)
+	clean.ImageName = scrubString(pod.ImageName)
+	clean.GpuTypeID = scrubString(pod.GpuTypeID)
+	clean.CPUFlavorID = scrubString(pod.CPUFlavorID)
+	clean.VolumeMountPath = scrubString(pod.VolumeMountPath)
+	clean.NetworkVolumeID = scrubString(pod.NetworkVolumeID)
+
+	clean.Ports = make([]string, len(pod.Ports))
+	for index, port := range pod.Ports {
+		clean.Ports[index] = scrubString(port)
+	}
+
+	var nestedChanged bool
+	clean.CreatedAt, nestedChanged = scrubCPUOutwardValue(pod.CreatedAt, controlSecret)
+	changed = changed || nestedChanged
+	clean.LastStatusChange, nestedChanged = scrubCPUOutwardValue(pod.LastStatusChange, controlSecret)
+	changed = changed || nestedChanged
+	clean.UptimeSeconds, nestedChanged = scrubCPUOutwardValue(pod.UptimeSeconds, controlSecret)
+	changed = changed || nestedChanged
+	clean.Machine, nestedChanged = scrubCPUStringInterfaceMap(pod.Machine, controlSecret)
+	changed = changed || nestedChanged
+	clean.Runtime, nestedChanged = scrubCPUStringInterfaceMap(pod.Runtime, controlSecret)
+	changed = changed || nestedChanged
+
+	// The create receipt never needs raw provider environment entries or the
+	// GET-only raw network-volume inspection. Their outward forms are metadata.
+	if pod.Env != nil {
+		clean.Env = nil
+		changed = true
+	}
+	if pod.NetworkVolumeInspection != nil {
+		clean.NetworkVolumeInspection = nil
+		changed = true
+	}
+	return &clean, changed
+}
+
+func scrubCPUStringInterfaceMap(input map[string]interface{}, controlSecret string) (map[string]interface{}, bool) {
+	if input == nil {
+		return nil, false
+	}
+	clean := make(map[string]interface{}, len(input))
+	changed := false
+	for key, value := range input {
+		cleanKey, keyChanged := scrubCPUControlSecretString(key, controlSecret)
+		changed = changed || keyChanged
+		if strings.EqualFold(cleanKey, "env") {
+			clean[cleanKey] = cpuEnvRedactionMetadata()
+			changed = true
+			continue
+		}
+		cleanValue, valueChanged := scrubCPUOutwardValue(value, controlSecret)
+		changed = changed || valueChanged
+		clean[cleanKey] = cleanValue
+	}
+	return clean, changed
+}
+
+func scrubCPUOutwardValue(value interface{}, controlSecret string) (interface{}, bool) {
+	switch typed := value.(type) {
+	case nil:
+		return nil, false
+	case string:
+		return scrubCPUControlSecretString(typed, controlSecret)
+	case []string:
+		clean := make([]string, len(typed))
+		changed := false
+		for index, item := range typed {
+			var itemChanged bool
+			clean[index], itemChanged = scrubCPUControlSecretString(item, controlSecret)
+			changed = changed || itemChanged
+		}
+		return clean, changed
+	case []interface{}:
+		clean := make([]interface{}, len(typed))
+		changed := false
+		for index, item := range typed {
+			var itemChanged bool
+			clean[index], itemChanged = scrubCPUOutwardValue(item, controlSecret)
+			changed = changed || itemChanged
+		}
+		return clean, changed
+	case map[string]interface{}:
+		return scrubCPUStringInterfaceMap(typed, controlSecret)
+	case map[string]string:
+		clean := make(map[string]string, len(typed))
+		changed := false
+		for key, item := range typed {
+			cleanKey, keyChanged := scrubCPUControlSecretString(key, controlSecret)
+			cleanItem, itemChanged := scrubCPUControlSecretString(item, controlSecret)
+			changed = changed || keyChanged || itemChanged
+			clean[cleanKey] = cleanItem
+		}
+		return clean, changed
+	default:
+		return value, false
+	}
+}
