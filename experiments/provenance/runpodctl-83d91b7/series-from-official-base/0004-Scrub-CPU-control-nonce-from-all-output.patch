+func TestCPUCreateEnvStdinScrubsProviderErrorVariants(t *testing.T) {
+	nonce := strings.Repeat("cD", 32)
+	echo := strings.ToUpper(nonce)
+	tests := []struct {
+		name       string
+		statusCode int
+		body       string
+	}{
+		{
+			name:       "http error nested key and value",
+			statusCode: http.StatusBadRequest,
+			body:       `{"error":{"` + echo + `":"provider-` + echo + `"}}`,
+		},
+		{
+			name:       "success status malformed numeric string",
+			statusCode: http.StatusOK,
+			body:       `{"id":"safe-id","name":"proxywar-mickey-cpu-canary","containerDiskInGb":20,"volumeInGb":0,"costPerHr":"` + echo + `"}`,
+		},
+		{
+			name:       "success status wrong typed name",
+			statusCode: http.StatusOK,
+			body:       `{"id":"safe-id","name":{"` + echo + `":"` + echo + `"},"containerDiskInGb":20,"volumeInGb":0,"costPerHr":0.06}`,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			viper.Reset()
+			t.Cleanup(viper.Reset)
+			setExactCPUCreateGlobals(t)
+			createEnvStdin = true
+			createPublicIP = true
+			createPorts = "22/tcp"
+
+			var deleteCalls atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method == http.MethodDelete {
+					deleteCalls.Add(1)
+					w.WriteHeader(http.StatusNoContent)
+					return
+				}
+				w.WriteHeader(tt.statusCode)
+				_, _ = w.Write([]byte(tt.body))
+			}))
+			t.Cleanup(server.Close)
+			t.Setenv("RUNPOD_API_KEY", "test-key")
+			t.Setenv("RUNPOD_API_URL", server.URL)
+
+			command := &cobra.Command{}
+			command.Flags().String("output", "json", "")
+			command.SetIn(strings.NewReader(`{"MICKEY_CONTROL_PLANE_NONCE":"` + nonce + `"}`))
+			stdout, stderr, runErr := captureRunCreateOutput(t, command)
+			if runErr == nil {
+				t.Fatal("expected provider response failure")
+			}
+			assertNoNonceFold(t, "stdout", stdout, nonce)
+			assertNoNonceFold(t, "stderr", stderr, nonce)
+			assertNoNonceFold(t, "returned error", []byte(runErr.Error()), nonce)
+			if len(stdout) != 0 {
+				t.Fatalf("provider parse/error path emitted a receipt: %q", stdout)
+			}
+			if got := deleteCalls.Load(); got != 0 {
+				t.Fatalf("DELETE calls = %d, want 0", got)
+			}
+		})
+	}
+}
