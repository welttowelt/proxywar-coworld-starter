+	stdin := strings.NewReader(`{"MICKEY_CONTROL_PLANE_NONCE":"` + nonce + `"}`)
+	command := &cobra.Command{}
+	command.Flags().String("env", "", "")
+	if err := command.Flags().Set("env", ""); err != nil {
+		t.Fatalf("set env flag: %v", err)
+	}
+	command.SetIn(stdin)
+
+	err := runCreate(command, nil)
+	if err == nil || !strings.Contains(err.Error(), "cannot be combined") {
+		t.Fatalf("error = %v, want explicit empty --env conflict", err)
+	}
+	if strings.Contains(err.Error(), nonce) {
+		t.Fatalf("conflict error leaked nonce: %v", err)
+	}
+	if stdin.Len() == 0 {
+		t.Fatal("conflicting --env-stdin input was consumed")
+	}
+}
