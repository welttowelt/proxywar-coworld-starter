+func TestCPUCreateEnvStdinBoundsAndScrubsReadErrors(t *testing.T) {
+	t.Run("oversized", func(t *testing.T) {
+		setExactCPUCreateGlobals(t)
+		createEnvStdin = true
+		command := &cobra.Command{}
+		command.SetIn(strings.NewReader(strings.Repeat("x", cpuEnvStdinMaxBytes+1)))
+
+		_, err := resolveCPUCreateEnv(command)
+		if err == nil || !strings.Contains(err.Error(), "exceeds") {
+			t.Fatalf("error = %v, want bounded input failure", err)
+		}
+	})
+
+	t.Run("reader error", func(t *testing.T) {
+		setExactCPUCreateGlobals(t)
+		createEnvStdin = true
+		nonce := strings.Repeat("c4", 32)
+		command := &cobra.Command{}
+		command.SetIn(nonceEchoingErrorReader{nonce: nonce})
+
+		_, err := resolveCPUCreateEnv(command)
+		if err == nil || !strings.Contains(err.Error(), "failed to read") {
+			t.Fatalf("error = %v, want read failure", err)
+		}
+		if strings.Contains(err.Error(), nonce) {
+			t.Fatalf("read failure leaked underlying reader text: %v", err)
+		}
+	})
+}
