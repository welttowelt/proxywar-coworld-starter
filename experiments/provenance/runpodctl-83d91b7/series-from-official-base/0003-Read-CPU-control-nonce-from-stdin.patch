+func TestCPUCreateEnvStdinRejectsGPUWithoutReading(t *testing.T) {
+	setExactCPUCreateGlobals(t)
+	createComputeType = "GPU"
+	createCloudType = "SECURE"
+	createEnvStdin = true
+	nonce := strings.Repeat("d5", 32)
+	stdin := strings.NewReader(`{"MICKEY_CONTROL_PLANE_NONCE":"` + nonce + `"}`)
+	command := &cobra.Command{}
+	command.SetIn(stdin)
+
+	err := runCreate(command, nil)
+	if err == nil || !strings.Contains(err.Error(), "only for compute type cpu") {
+		t.Fatalf("error = %v, want CPU-only rejection", err)
+	}
+	if strings.Contains(err.Error(), nonce) {
+		t.Fatalf("GPU rejection leaked nonce: %v", err)
+	}
+	if stdin.Len() == 0 {
+		t.Fatal("GPU --env-stdin input was consumed")
+	}
+}
