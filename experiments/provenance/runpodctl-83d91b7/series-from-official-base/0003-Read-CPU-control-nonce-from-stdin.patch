+func TestCPUCreateEnvStdinHashesRawNonceWithoutArgvGlobalOrReceiptLeak(t *testing.T) {
+	viper.Reset()
+	t.Cleanup(viper.Reset)
+	setExactCPUCreateGlobals(t)
+	createEnvStdin = true
+	nonce := strings.Repeat("e1", 32)
+	encodedEnv := `{"MICKEY_CONTROL_PLANE_NONCE":"` + nonce + `"}`
+
+	requestBody := make(chan map[string]interface{}, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost || r.URL.Path != "/pods" {
+			t.Errorf("request = %s %s, want POST /pods", r.Method, r.URL.Path)
+		}
+		var body map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Errorf("decode request: %v", err)
+			return
+		}
+		requestBody <- body
+		_ = json.NewEncoder(w).Encode(api.Pod{
+			ID:                "cpu-pod-stdin-env",
+			Name:              createName,
+			ComputeType:       "CPU",
+			CloudType:         "COMMUNITY",
+			ImageName:         createImageName,
+			ContainerDiskInGb: 20,
+			MemoryInGb:        4,
+			VcpuCount:         2,
+			CostPerHr:         0.06,
+			Env: map[string]string{
+				cpuControlPlaneNonceEnvKey: nonce,
+			},
+		})
+	}))
+	t.Cleanup(server.Close)
+	t.Setenv("RUNPOD_API_KEY", "test-key")
+	t.Setenv("RUNPOD_API_URL", server.URL)
+
+	command := &cobra.Command{}
+	command.Flags().String("output", "json", "")
+	command.SetIn(strings.NewReader(encodedEnv))
+
+	oldArgs := os.Args
+	os.Args = []string{"runpodctl", "pod", "create", "--env-stdin"}
+	t.Cleanup(func() { os.Args = oldArgs })
+
+	readEnd, writeEnd, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("pipe: %v", err)
+	}
+	oldStdout := os.Stdout
+	os.Stdout = writeEnd
+	t.Cleanup(func() {
+		os.Stdout = oldStdout
+		_ = readEnd.Close()
+		_ = writeEnd.Close()
+	})
+
+	if err := runCreate(command, nil); err != nil {
+		t.Fatalf("create pod: %v", err)
+	}
+	_ = writeEnd.Close()
+	os.Stdout = oldStdout
+	stdout, err := io.ReadAll(readEnd)
+	if err != nil {
+		t.Fatalf("read stdout: %v", err)
+	}
+	body := <-requestBody
+	rawEnv, ok := body["env"].(map[string]interface{})
+	if !ok || rawEnv[cpuControlPlaneNonceEnvKey] != nonce {
+		t.Fatalf("raw REST request env = %#v, want nonce", body["env"])
+	}
+	if createEnv != "" {
+		t.Fatalf("stdin nonce was copied into createEnv global")
+	}
+	if strings.Contains(strings.Join(os.Args, "\x00"), nonce) {
+		t.Fatalf("stdin nonce appeared in process argv")
+	}
+	if strings.Contains(string(stdout), nonce) {
+		t.Fatalf("stdout receipt leaked stdin nonce: %s", stdout)
+	}
+
+	var receipt map[string]interface{}
+	if err := json.Unmarshal(stdout, &receipt); err != nil {
+		t.Fatalf("stdout is not a parseable receipt: %v: %q", err, stdout)
+	}
+	rawCanonical, err := canonicalRESTRequestJSON(body)
+	if err != nil {
+		t.Fatalf("canonical raw request: %v", err)
+	}
+	rawDigest := sha256.Sum256(rawCanonical)
+	if receipt["requestInputSha256"] != hex.EncodeToString(rawDigest[:]) {
+		t.Fatalf("request hash was not computed over raw stdin nonce request: %#v", receipt)
+	}
+	requestInput, ok := receipt["requestInput"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("requestInput = %#v", receipt["requestInput"])
+	}
+	redactedRequestEnv, ok := requestInput["env"].(map[string]interface{})
+	if !ok || redactedRequestEnv[cpuControlPlaneNonceEnvKey] != cpuEnvRedactedValueMarker {
+		t.Fatalf("redacted request env = %#v", requestInput["env"])
+	}
+}
