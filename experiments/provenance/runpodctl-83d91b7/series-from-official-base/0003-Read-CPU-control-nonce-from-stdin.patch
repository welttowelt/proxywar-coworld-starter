+func TestCPUCreateEnvStdinRejectsConflictWithoutReadingOrLeaking(t *testing.T) {
+	setExactCPUCreateGlobals(t)
+	createEnvStdin = true
+	argvNonce := strings.Repeat("a2", 32)
+	stdinNonce := strings.Repeat("b3", 32)
+	createEnv = `{"MICKEY_CONTROL_PLANE_NONCE":"` + argvNonce + `"}`
+	stdin := strings.NewReader(`{"MICKEY_CONTROL_PLANE_NONCE":"` + stdinNonce + `"}`)
+	command := &cobra.Command{}
+	command.SetIn(stdin)
+
+	err := runCreate(command, nil)
+	if err == nil || !strings.Contains(err.Error(), "cannot be combined") {
+		t.Fatalf("error = %v, want --env/--env-stdin conflict", err)
+	}
+	if strings.Contains(err.Error(), argvNonce) || strings.Contains(err.Error(), stdinNonce) {
+		t.Fatalf("conflict error leaked nonce: %v", err)
+	}
+	if stdin.Len() == 0 {
+		t.Fatal("conflicting --env-stdin input was consumed")
+	}
+}
+
+func TestCPUCreateEnvStdinRejectsExplicitEmptyEnvFlag(t *testing.T) {
+	setExactCPUCreateGlobals(t)
+	createEnvStdin = true
