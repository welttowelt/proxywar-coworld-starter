+func createPodRESTWithEnv(computeType, gpuTypeID, cloudType string, supportPublicIP bool, encodedEnv string) (interface{}, error) {
 	client, err := api.NewClient()
 	if err != nil {
 		return nil, err
@@ -322,15 +340,15 @@ func createPodREST(computeType, gpuTypeID, cloudType string, supportPublicIP boo
 		req.DockerArgs = createDockerArgs
 	}
 
-	if createEnv != "" {
+	if encodedEnv != "" {
 		var env map[string]string
 		if computeType == "CPU" {
 			var err error
-			env, err = parseCPUCreateEnv(createEnv)
+			env, err = parseCPUCreateEnv(encodedEnv)
 			if err != nil {
 				return nil, err
 			}
-		} else if err := json.Unmarshal([]byte(createEnv), &env); err != nil {
+		} else if err := json.Unmarshal([]byte(encodedEnv), &env); err != nil {
 			return nil, fmt.Errorf("invalid env json: %w", err)
 		}
 		req.Env = env
@@ -368,6 +386,7 @@ var requiredCPUFlavorIDs = []string{"cpu5c", "cpu3c"}
 const (
 	requiredCPUFlavorPriority     = "custom"
 	cpuControlPlaneNonceEnvKey    = "MICKEY_CONTROL_PLANE_NONCE"
+	cpuEnvStdinMaxBytes           = 1024
 	restRequestInputHashAlgorithm = "sorted-json-sha256-v1"
 	restRequestInputHashScope     = "raw-request-before-redaction"
 	cpuEnvRedactionSchema         = "env-values-v1"
@@ -412,27 +431,63 @@ func validateCPUCreateConfig(cloudType string) error {
 	if strings.TrimSpace(createStopAfter) != "" || strings.TrimSpace(createTerminateAfter) != "" {
 		return fmt.Errorf("CPU REST create does not support --stop-after or --terminate-after; use an independent exact-ID cleanup watchdog")
 	}
-	if _, err := parseCPUCreateEnv(createEnv); err != nil {
-		return err
+	if createEnvStdin && strings.TrimSpace(createEnv) != "" {
+		return fmt.Errorf("cpu --env-stdin cannot be combined with --env")
+	}
+	if !createEnvStdin {
+		if _, err := parseCPUCreateEnv(createEnv); err != nil {
+			return err
+		}
 	}
 	return nil
 }
 
+func resolveCPUCreateEnv(cmd *cobra.Command) (string, error) {
+	if !createEnvStdin {
+		return createEnv, nil
+	}
+	if strings.TrimSpace(createEnv) != "" {
+		return "", fmt.Errorf("cpu --env-stdin cannot be combined with --env")
+	}
+	if cmd == nil {
+		return "", fmt.Errorf("cpu --env-stdin input is unavailable")
+	}
+
+	encoded, err := io.ReadAll(io.LimitReader(cmd.InOrStdin(), cpuEnvStdinMaxBytes+1))
+	if err != nil {
+		return "", fmt.Errorf("failed to read cpu --env-stdin input")
+	}
+	if len(encoded) > cpuEnvStdinMaxBytes {
+		return "", fmt.Errorf("cpu --env-stdin input exceeds %d bytes", cpuEnvStdinMaxBytes)
+	}
+	if strings.TrimSpace(string(encoded)) == "" {
+		return "", fmt.Errorf("cpu --env-stdin requires a json object containing only a 64-hex %s value", cpuControlPlaneNonceEnvKey)
+	}
+	if _, err := parseCPUCreateEnvSource(string(encoded), "--env-stdin"); err != nil {
+		return "", err
+	}
+	return string(encoded), nil
+}
+
 func parseCPUCreateEnv(encoded string) (map[string]string, error) {
+	return parseCPUCreateEnvSource(encoded, "--env")
+}
+
+func parseCPUCreateEnvSource(encoded, source string) (map[string]string, error) {
 	if strings.TrimSpace(encoded) == "" {
 		return nil, nil
 	}
 	var env map[string]string
 	if err := json.Unmarshal([]byte(encoded), &env); err != nil {
-		return nil, fmt.Errorf("CPU --env must be a JSON object containing only a 64-hex %s value", cpuControlPlaneNonceEnvKey)
+		return nil, fmt.Errorf("cpu %s must be a json object containing only a 64-hex %s value", source, cpuControlPlaneNonceEnvKey)
 	}
 	nonce, ok := env[cpuControlPlaneNonceEnvKey]
 	if !ok || len(env) != 1 || len(nonce) != 64 {
-		return nil, fmt.Errorf("CPU --env must contain only a 64-hex %s value", cpuControlPlaneNonceEnvKey)
+		return nil, fmt.Errorf("cpu %s must contain only a 64-hex %s value", source, cpuControlPlaneNonceEnvKey)
 	}
 	decoded, err := hex.DecodeString(nonce)
 	if err != nil || len(decoded) != 32 {
-		return nil, fmt.Errorf("CPU --env must contain only a 64-hex %s value", cpuControlPlaneNonceEnvKey)
+		return nil, fmt.Errorf("cpu %s must contain only a 64-hex %s value", source, cpuControlPlaneNonceEnvKey)
 	}
 	return env, nil
 }
