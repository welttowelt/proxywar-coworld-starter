{
  "name": "proxywar-agent-llm",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "ProxyWar deterministic standard controller with exact legal-action selection.",
  "scripts": {
    "test": "node --test",
    "data:collect": "node scripts/collect-proxywar-data.mjs --rounds 20",
    "data:analyze": "duckdb < analytics/meta.sql",
    "data:refresh": "npm run data:collect && npm run data:analyze && npm run rci:report",
    "cache:prune": "node scripts/prune-replay-cache.mjs --apply",
    "gate:audit": "node scripts/audit-xp-gate.mjs",
    "experiment:audit-mirrors": "node scripts/audit-local-mirrors.mjs",
    "experiment:preflight": "node scripts/validate-experiment-preflight.mjs",
    "rci:report": "node scripts/rci-report.mjs",
    "rci:gate": "node scripts/rci-report.mjs --strict",
    "dashboard:serve": "npx --yes serve site --listen 4173",
    "dashboard:update": "bash scripts/publish-dashboard.sh"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
