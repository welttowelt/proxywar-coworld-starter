# The policy image contains only these files.  Keep the build context
# allowlisted: replay history and prior episode output are several gigabytes
# and otherwise have to be tarred and sent to BuildKit on every edit.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!llm-player.mjs
!intent-controller.mjs
!captain-underpants-production-doctrine.mjs
!strategy-engine.mjs
!strategy-chassis.mjs
!planner-backoff.mjs
!starter-player.mjs
